# Port the API listens on
PORT=4000

# Website origin(s) allowed to call this API (comma-separated). Also used as the CSRF check.
#   Local:       http://localhost:3000
#   Production:  your deployed frontend, e.g. https://balaju-heritage.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Chatbot (free key from https://aistudio.google.com/apikey) ---
# Without it the chatbot still works, answering directly from the verified notes in src/data/content.ts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Admin login (visitors do not need accounts) ---
# Create the admin with:  npm run make-admin -- you@example.com "a strong password"
# Signs the login cookie. Required in production (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Database (PostgreSQL, database name: hoc) ---
# Local PostgreSQL. Put your postgres password in place of YOUR_PASSWORD, then run: npm run db:setup
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hoc
