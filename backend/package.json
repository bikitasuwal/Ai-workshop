{
  "name": "balaju-heritage-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "predev": "node scripts/sync-content.mjs",
    "build": "tsc",
    "prebuild": "node scripts/sync-content.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/sync-content.mjs",
    "db:setup": "tsx --env-file-if-exists=.env scripts/setup-db.ts",
    "make-admin": "tsx --env-file-if-exists=.env scripts/make-admin.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.16",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
